# 高德 JSAPI（Web 端 Key + 安全密钥，见 https://console.amap.com/ ）
# 复制为 .env.local 后填写；勿将 .env.local 提交到版本库
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JSCODE=
#
# 可选：运行环境标签（仅标识，不参与后端逻辑）
# VITE_APP_ENV=development
#
# 可选：后端 API 根地址（前后端不同域时必须配置）
# 本地开发留空即可（走 Vite 代理 /api → 8000）
# VITE_API_BASE_URL=https://api.your-domain.com
