# 复制为 backend/.env 后按需修改（不要将含真实密码的 .env 提交到版本库）
#
# 日常运行：只用「集群内网」DATABASE_URL（见 deploy/database.env.example）
# 数据迁移：仅用外网地址，执行 scripts/migrate_dev_db_to_prod.py

# ========== 开发环境（DevBox / 开发后端 Pod）==========
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@bus-system-postgresql.ns-1ht608x0.svc:5432/bus_system_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=https://xwyommoychvz.sealosbja.site,http://127.0.0.1:5173,http://localhost:5173
DEMO_SEEDING_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123!@#
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# ========== 生产环境（在 Sealos 生产后端应用环境变量中配置，见 deploy/sealos-backend-production.env.example）==========
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@test-db-postgresql.ns-1ht608x0.svc:5432/bus_system_test
# JWT_SECRET=<随机长串>
# CORS_ORIGINS=https://你的生产前端域名
# DEMO_SEEDING_ENABLED=false

# ========== 本机 Docker 映射 PostgreSQL（可选）==========
# DATABASE_URL=postgresql+psycopg2://bus_test:bus_test_123@127.0.0.1:55432/bus_system_test
