# 复制为 .env 后按需修改（不要将含真实密码的 .env 提交到版本库）
#
# 环境标识（与部署一致即可，仅用于区分与健康检查展示）
# 建议：本地 development；自动化测试 test；预发 staging 或 preprod；正式 production
ENVIRONMENT=development
#
DATABASE_URL=postgresql+psycopg2://bus_test:bus_test_123@127.0.0.1:55432/bus_system_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
# 浏览器访问前端的 Origin，逗号分隔。生产环境改为 https://你的域名
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
#
# 演示数据与演示账号（fleet_mgr/driver1/staff1 等）。正式上线务必 false
DEMO_SEEDING_ENABLED=true
#
# 首次启动若库中无该用户则自动创建
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123!@#
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
