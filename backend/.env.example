# 复制为 backend/.env 后按需修改（不要将含真实密码的 .env 提交到版本库）
#
# 本机开发推荐使用项目内 SQLite；Sealos 环境使用 PostgreSQL。
# 数据迁移：仅用外网地址，执行 scripts/migrate_dev_db_to_prod.py

# ========== 本机开发（推荐，无需安装数据库服务）==========
# DATABASE_URL=sqlite:///./data/local-dev.db
# DEMO_SEEDING_ENABLED=true

# ========== 开发环境（DevBox / 开发后端 Pod）==========
ENVIRONMENT=development

# 油卡余额同步使用本地昆仑脚本；留空时自动寻找项目同级“中国石油/获取油卡余额.py”。
# 脚本继续使用其同目录的 登录.py、config.json、token.json。
KUNLUN_BALANCE_SCRIPT=
MAX_UPLOAD_MB=50
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@hebgwd-fullstack-db-postgresql.ns-1ht608x0.svc:5432/hebgwd_development
# 本地开发可保持 true；生产由 initContainer/Job 执行 python -m app.db.bootstrap，API Pod 必须为 false。
AUTO_DB_INIT=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=https://xwyommoychvz.sealosbja.site,http://127.0.0.1:5173,http://localhost:5173
DEMO_SEEDING_ENABLED=false
UPLOAD_DIR=/data/uploads
# 本机开发可使用 local；生产环境强制使用私有 S3。
MEDIA_STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=hebgwd-vehicle-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRE_SECONDS=300
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123!@#
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# ========== 生产环境（在 Sealos 生产后端应用环境变量中配置，见 deploy/sealos-backend-production.env.example）==========
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@PRODUCTION_DB_HOST:5432/PRODUCTION_DB_NAME
# AUTO_DB_INIT=false
# JWT_SECRET=<随机长串>
# CORS_ORIGINS=https://你的生产前端域名
# DEMO_SEEDING_ENABLED=false
# MEDIA_STORAGE_BACKEND=s3
# S3_ENDPOINT=https://<object-storage-endpoint>
# S3_ACCESS_KEY_ID=<secret>
# S3_SECRET_ACCESS_KEY=<secret>
# S3_BUCKET=hebgwd-vehicle-assets

# ========== AI 结算单识别（智谱 GLM-4.6V）==========
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6v

# DATABASE_URL=postgresql+psycopg2://hebgwd_dev:CHANGE_ME@127.0.0.1:55432/hebgwd_development
