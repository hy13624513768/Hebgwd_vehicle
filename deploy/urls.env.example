# 当前 Sealos 环境前后端公网根地址（无尾斜杠）。
# 在 bash 中加载： set -a && source deploy/urls.env.example && set +a
#
# 后端控制台：CORS_ORIGINS 须包含 FRONTEND_PUBLIC_ORIGIN（多个用英文逗号）。
# 前端构建：VITE_API_BASE_URL 与 BACKEND_PUBLIC_ORIGIN 一致（或由 Docker --build-arg 传入）。
# 勿将含数据库密码、JWT 的文件提交仓库。

FRONTEND_PUBLIC_ORIGIN=https://xwyommoychvz.sealosbja.site
BACKEND_PUBLIC_ORIGIN=https://nrnsbrodowei.sealosbja.site
VITE_API_BASE_URL=https://nrnsbrodowei.sealosbja.site
