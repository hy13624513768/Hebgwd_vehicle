# 复制到 Sealos「生产后端应用」→ 环境变量（勿提交含真实密码的文件到 Git）
# 与 deploy/urls.env.example 中的公网域名配合使用。

ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@PRODUCTION_DB_HOST:5432/PRODUCTION_DB_NAME
AUTO_DB_INIT=false
# 单个 API Pod 的连接池上限为 POOL_SIZE + MAX_OVERFLOW；多副本时按 Pod 数计算数据库总连接数。
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=https://xwyommoychvz.sealosbja.site
DEMO_SEEDING_ENABLED=false
# 昆仑同步脚本在 API Pod 内运行，由 initContainer 写入此云端路径。
KUNLUN_BALANCE_SCRIPT=/app/kunlun/获取油卡余额.py
MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT=https://CHANGE_ME_OBJECT_STORAGE_ENDPOINT
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=hebgwd-vehicle-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRE_SECONDS=300
MAX_UPLOAD_MB=50
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
