# 复制为 deploy/.env.acr 后填写（deploy/.env.acr 已被 git 忽略，勿提交）
# 填写完成后构建并推送镜像：cd hebgwd_vehicle && bash deploy/push-acr.sh
#
# 镜像仓库与控制台一致：
# https://cr.console.aliyun.com/repository/cn-beijing/hebgwd/hebgwd_vehicle_frontend/details
# https://cr.console.aliyun.com/repository/cn-beijing/hebgwd/hebgwd_vehicle_backend/details

ACR_REGISTRY=registry.cn-beijing.aliyuncs.com
ACR_NAMESPACE=hebgwd
FRONTEND_REPO=hebgwd_vehicle_frontend
BACKEND_REPO=hebgwd_vehicle_backend
# 留空时 push-acr.sh 自动生成“UTC 时间-Git短哈希”；也可显式填写不可变版本号。
IMAGE_TAG=

# 必填：前端打包时写入的 API 根地址（无末尾斜杠），需指向浏览器能访问的后端公网地址。
# Sealos 建议：先在「应用管理」部署后端，从该应用的「外网访问」复制 HTTPS 根地址（不要 /api 后缀），
# 再填到此处并重新构建前端镜像；同时在后端环境变量 CORS_ORIGINS 里加入前端的公网地址（逗号分隔）。
VITE_API_BASE_URL=https://your-backend.example.com

# 必填：高德 JS API 2.0 的 Web 端 Key 与该 Key 对应的安全密钥。
# 这两项会在构建时写入前端静态文件；只在 Sealos 容器运行环境中补填不会生效。
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JSCODE=
